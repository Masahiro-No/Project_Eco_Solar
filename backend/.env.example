# Copy to backend/.env (cp backend/.env.example backend/.env). The API and the ingestion worker read it.
# Only jwt_secret_key has to be filled in: the other values already match the stack in compose.yml.

# Signs the login tokens. Put your own long random text here (at least 16 characters), for example from:
#   docker run --rm python:3.12-slim python -c "import secrets; print(secrets.token_urlsafe(48))"
jwt_secret_key=
jwt_algorithm=HS256
access_token_expire_minutes=60

database_url=postgresql+asyncpg://myuser:mypassword@postgres/mydatabase
redis_host=redis
redis_port=6379

# Must match MINIO_ROOT_USER / MINIO_ROOT_PASSWORD in compose.yml.
minio_endpoint=minio:9000
minio_access_key=admin
minio_secret_key=password

label_studio_url=http://label-studio:8080
# Leave empty: the API gets the token from LABEL_STUDIO_API_KEY in the root .env.
label_studio_api_key=
