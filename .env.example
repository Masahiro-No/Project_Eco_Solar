# Copy to .env and fill in. docker compose reads .env automatically.
# Label Studio > Account & Settings > Personal Access Token (of your own local Label Studio)
LABEL_STUDIO_API_KEY=

# Admin account of the web app (private zone: labeling, station management, jobs).
# Created at API startup when ADMIN_PASSWORD is set (min 8 characters).
ADMIN_EMAIL=admin@solardss.io
ADMIN_PASSWORD=
